# OS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/

# cr-renderer is a separate, external open-source project
# (https://github.com/CyberAgentAILab/cr-renderer), pulled in locally for
# reference/dev and installed by the engines via
# `pip install git+https://github.com/CyberAgentAILab/cr-renderer` — not
# vendored into this repo.
/cr-renderer/

# Generated run artifacts
output/*
!output/.gitkeep

# Benchmark renders (regenerate with: python -m eval.bench --render)
eval/results/renders/
eval/results/contact_sheet.png
eval/results/outputs/

# Crello suites: outputs, renders and labels contain Crello content (text, images). Only
# summary.md and cases.csv are committed. The converted designs live outside the repo.
eval/results/crello-*/outputs/
eval/results/crello-*/renders/
eval/results/crello-*/labels.json
eval/results/crello-*/.labels.*
